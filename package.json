{
  "name": "tron",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer light-cycles for tron.kodloki.io",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --minify --outfile=dist/public/main.js && cp public/index.html dist/public/index.html",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
